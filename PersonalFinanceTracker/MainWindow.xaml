<Window x:Class="PersonalFinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalFinanceTracker.ViewModels"
        mc:Ignorable="d"
        Title="Personal Finance Tracker" Height="560" Width="1100"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="SelectionDependentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedExpense}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Фильтры" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Категория" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding FilterCategory, Mode=TwoWay}"
                          IsEditable="True"/>

                <TextBlock Text="Дата с" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>

                <TextBlock Text="Дата по" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"/>

                <Button Content="Применить фильтр"
                        Command="{Binding ApplyFilterCommand}"
                        Margin="0,16,0,0"/>

                <Button Content="Сбросить фильтр"
                        Command="{Binding ResetFilterCommand}"/>

                <Separator Margin="0,16,0,8"/>

                <TextBlock Text="Итого" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                           FontSize="20" FontWeight="Bold" Foreground="#2A6"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="12,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Expenses}"
                      SelectedItem="{Binding SelectedExpense, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Расход" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Лимит"     Style="{StaticResource LabelStyle}"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding DraftExpense.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding DraftLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, TargetNullValue=''}"/>
                </Grid>

                <TextBlock Text="Сумма" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding DraftExpense.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>

                <TextBlock Text="Дата" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding DraftExpense.Date, Mode=TwoWay}"/>

                <TextBlock Text="Описание" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding DraftExpense.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>

                <Button Content="Добавить"
                        Command="{Binding AddExpenseCommand}"
                        Margin="0,16,0,0"/>

                <Button Content="Сохранить изменения"
                        Style="{StaticResource SelectionDependentButton}"
                        Command="{Binding EditExpenseCommand}"
                        CommandParameter="{Binding SelectedExpense}"/>

                <Button Content="Удалить"
                        Style="{StaticResource SelectionDependentButton}"
                        Command="{Binding DeleteExpenseCommand}"
                        CommandParameter="{Binding SelectedExpense}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"
                Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Статистика"
                        Command="{Binding ShowStatisticsCommand}"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid x:Name="ExportGroup" Width="120" Margin="0,0,8,0" Background="Transparent">
                        <Button Content="Экспорт">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ExportGroup}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ExportGroup}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="JSON" MinWidth="0" Command="{Binding ExportJsonCommand}"/>
                            <Button Grid.Column="2" Content="CSV"  MinWidth="0" Command="{Binding ExportCsvCommand}"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ImportGroup" Width="120" Background="Transparent">
                        <Button Content="Импорт">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ImportGroup}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ImportGroup}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="JSON" MinWidth="0" Command="{Binding ImportJsonCommand}"/>
                            <Button Grid.Column="2" Content="CSV"  MinWidth="0" Command="{Binding ImportCsvCommand}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
