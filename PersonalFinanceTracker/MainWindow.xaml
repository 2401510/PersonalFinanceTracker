<Window x:Class="PersonalFinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalFinanceTracker.ViewModels"
        mc:Ignorable="d"
        Title="Personal Finance Tracker" Height="560" Width="1100"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Фильтры" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Категория" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding FilterCategory, Mode=TwoWay}"
                          IsEditable="True"/>

                <TextBlock Text="Дата с" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>

                <TextBlock Text="Дата по" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"/>

                <Button Content="Применить фильтр"
                        Command="{Binding ApplyFilterCommand}"
                        Margin="0,16,0,0"/>

                <Separator Margin="0,16,0,8"/>

                <TextBlock Text="Итого" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                           FontSize="20" FontWeight="Bold" Foreground="#2A6"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="12,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Expenses}"
                      SelectedItem="{Binding SelectedExpense, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="2" Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Расход" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Категория" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding SelectedExpense.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Сумма" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding SelectedExpense.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>

                <TextBlock Text="Дата" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding SelectedExpense.Date, Mode=TwoWay}"/>

                <TextBlock Text="Описание" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding SelectedExpense.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>

                <Button Content="Добавить"
                        Command="{Binding AddExpenseCommand}"
                        Margin="0,16,0,0"/>

                <Button Content="Сохранить изменения"
                        Command="{Binding EditExpenseCommand}"
                        CommandParameter="{Binding SelectedExpense}"/>

                <Button Content="Удалить"
                        Command="{Binding DeleteExpenseCommand}"
                        CommandParameter="{Binding SelectedExpense}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
