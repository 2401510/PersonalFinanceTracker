<Window x:Class="PersonalFinanceTracker.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalFinanceTracker.ViewModels"
        mc:Ignorable="d"
        Title="Статистика расходов" Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="140"/>
                    <DataGridTextColumn Header="Кол-во записей" Binding="{Binding Count}" Width="140"/>
                    <DataGridTextColumn Header="% от общего" Binding="{Binding Percent, StringFormat={}{0:N2} %}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0"
                Background="#F7F7F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Итого:" FontWeight="Bold" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                           FontSize="18" FontWeight="Bold" Foreground="#2A6" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
